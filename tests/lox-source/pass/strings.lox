class Holder {
  init(s) {
    this.s = s;
  }
  getS() {
    return this.s;
  }
  setS(v) {
    this.s = v;
  }
}

let h = Holder("hello");
let hs = h.getS();
h.setS("world");
let hs2 = h.getS();
let hsEq = hs == "hello";
let hs2Eq = hs2 == "world";

