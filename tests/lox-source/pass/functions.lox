fun apply(f, x) {
  return f(x);
}

fun inc(n) {
  return n + 1;
}

let applied = apply(inc, 5);

fun mk() {
  fun inner() {
    return 1;
  }
  return inner;
}

let fn = mk();
let val = fn();

