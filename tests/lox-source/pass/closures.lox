let results = [0, 0, 0];
let idx = 0;
for (let i = 0; i < 3; i = i + 1) {
  fun cap() {
    return i;
  }
  results[idx] = cap();
  idx = idx + 1;
}

fun mk() {
  let c = 0;
  fun inc() {
    c = c + 1;
    return c;
  }
  fun get() {
    return c;
  }
  return [inc, get];
}

let pair = mk();
let incFn = pair[0];
let getFn = pair[1];
let after1 = incFn();
let visible = getFn();
let after2 = incFn();
let visible2 = getFn();
